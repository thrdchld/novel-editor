{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novel Editor Finding",
  "type": "object",
  "required": [
    "id",
    "severity",
    "category",
    "title",
    "location",
    "problem",
    "reader_impact",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "ERROR",
        "HIGH",
        "REVIEW",
        "INFO"
      ]
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "scene": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quote"
        ],
        "properties": {
          "quote": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "established_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "problem": {
      "type": "string"
    },
    "reader_impact": {
      "type": "string"
    },
    "recommendation": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "additionalProperties": false
}